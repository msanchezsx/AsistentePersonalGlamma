# =====================================================================
# Asistente Ejecutivo Personal — Variables de entorno
# Copia este archivo como .env.local (desarrollo) y configura los mismos
# valores en Vercel (Settings → Environment Variables) para producción.
# NUNCA subas .env.local ni claves reales al repositorio.
# =====================================================================

# --- Aplicación ------------------------------------------------------
# URL pública de la app (se usa para los enlaces de inicio de sesión).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Zona horaria del usuario.
APP_TIMEZONE=America/Mexico_City
# Correos autorizados para iniciar sesión, separados por coma.
ALLOWED_EMAILS=tu.correo@example.com

# --- Supabase (Fase 0) ------------------------------------------------
# Supabase Dashboard → Project Settings → API.
# La URL y la clave pública (publishable, sb_publishable_…) pueden llegar al
# navegador: la protección real la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa para proyectos antiguos (clave "anon"). Usa solo una de las dos.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor (salta RLS). No usar prefijo NEXT_PUBLIC_.
# Se necesitará a partir de la Fase 4 (automatizaciones).
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (Fase 2) ----------------------------------------------
# console.anthropic.com → API Keys. Solo servidor.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por omisión claude-opus-5-5).
ANTHROPIC_MODEL=

# --- Microsoft Graph / Outlook (Fase 3) -------------------------------
# Azure Portal → App registrations. Permisos iniciales: Mail.Read, offline_access.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=common
# Clave de 32 bytes (base64) para cifrar los tokens OAuth guardados.
TOKEN_ENCRYPTION_KEY=

# --- n8n y notificaciones (Fase 4) ------------------------------------
# Secreto compartido para que n8n llame a los endpoints internos.
N8N_WEBHOOK_SECRET=
# Claves VAPID para Web Push (npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu.correo@example.com

# --- Podcast / texto a voz (Fase 5) -----------------------------------
TTS_PROVIDER=
TTS_API_KEY=
